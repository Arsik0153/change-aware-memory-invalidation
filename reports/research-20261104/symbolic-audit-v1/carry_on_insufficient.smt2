(set-option :produce-proofs true)
(set-option :timeout 10000)
(set-logic QF_LIA)
(declare-const K Int)
(declare-const b0 Int)
(declare-const t0 Bool)
(declare-const a0 Bool)
(declare-const hint Bool)
(declare-const t1 Bool)
(declare-const v Int)
(declare-const changed Bool)
(declare-const step Int)
(define-fun selected () Bool (or hint (not a0) (>= (+ b0 1) K)))
(define-fun a1 () Bool (ite selected (ite (= v 2) a0 (= v 0)) a0))
(define-fun b1 () Int (ite selected 0 (+ b0 1)))
(define-fun unsafe0 () Bool (and a0 (not t0)))
(define-fun unsafe1 () Bool (and a1 (not t1)))
(define-fun inv0 () Bool (and (>= b0 0) (< b0 K) (=> unsafe0 (> b0 0))))
(define-fun inv1 () Bool (and (>= b1 0) (< b1 K) (=> unsafe1 (> b1 0))))
(assert (>= K 1))
(assert (and (>= v 0) (<= v 2)))
(assert (=> (and selected (= v 0)) t1))
(assert inv0)
(assert (= K 4))
(assert (= b0 3))
(assert a0)
(assert t0)
(assert (not t1))
(assert (= v 2))
(assert (not inv1))
(check-sat)
(get-value (K b0 t0 a0 hint t1 v changed step selected a1 b1))
