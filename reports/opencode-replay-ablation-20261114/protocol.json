          "id": "click-help-option-api",
          "oracle_root": "oracles",
          "prompt": "Consolidate Click's duplicated built-in help-option behavior into a reusable public click.HelpOption class derived from Option. It should default to --help, an eager flag that prints help and exits without passing a value to the command. Use the same class for automatically generated command help and the help_option decorator. Preserve custom option names, disabled automatic help, resilient parsing, existing help output/color behavior, explicit option keyword overrides (including callback), and the decorator's custom cls support. Keep existing applications working and add focused tests. Work only in this repository; do not look up the upstream implementation or use the network. Run relevant local tests and summarize the change.",
          "pytest_selection": null,
          "regression": "tests",
          "replace_regression_tests": null
        },
        {
          "acceptance": [
            "oracles/test_commands.py"
          ],
          "archive": "fixtures/click-help-eagerness-base.tar.gz",
          "archive_sha256": "f068a1ec2331afb8a716f4d050120502be07659e19c62378bd640df15bcd15e7",
          "id": "click-help-eagerness",
          "oracle_root": "oracles",
          "prompt": "Fix the ordering of Click's automatically generated help option when help_option_names supplies a custom name. For a command with a non-eager flag -a, an eager flag -b whose callback prints and exits, and automatic --my-help: --my-help before -b must print help, while -b before --my-help must invoke -b. Help must take precedence over the non-eager flag regardless of order. Keep ordinary callback ordering, disabled help, and other option behavior intact. Add focused regression tests. Work only in this repository; do not look up the upstream implementation or use the network. Run relevant local tests and summarize the change.",
          "pytest_selection": "help_param_priority or iter_params_for_processing",
          "regression": "tests",
          "replace_regression_tests": null
        }
      ]
    },
