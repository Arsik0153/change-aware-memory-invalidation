        "id": "click-help-eagerness",
        "oracle_root": "oracles",
        "prompt": "Fix the ordering of Click's automatically generated help option when help_option_names supplies a custom name. For a command with a non-eager flag -a, an eager flag -b whose callback prints and exits, and automatic --my-help: --my-help before -b must print help, while -b before --my-help must invoke -b. Help must take precedence over the non-eager flag regardless of order. Keep ordinary callback ordering, disabled help, and other option behavior intact. Add focused regression tests. Work only in this repository; do not look up the upstream implementation or use the network. Run relevant local tests and summarize the change.",
        "pytest_selection": "help_param_priority or iter_params_for_processing",
        "regression": "tests",
        "replace_regression_tests": null
      }
