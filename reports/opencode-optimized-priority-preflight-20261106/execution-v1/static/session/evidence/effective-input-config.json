{
  "model": "openai/gpt-6.1-sol#high",
  "update": "disable",
  "share": "disabled",
  "warming": false,
  "snapshots": false,
  "compaction": {
    "auto": false
  },
  "websearch": false,
  "plugins": [
    "-opencode.tool.subagent",
    "-opencode.tool.webfetch",
    "-opencode.tool.websearch",
    "-opencode.tool.image-generate",
    "-opencode.tool.schedule",
    "-opencode.tool.question",
    "-opencode.tool.artifact"
  ],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "agents": {
    "research": {
      "mode": "primary",
      "steps": 20,
      "system": "Complete the user task using only /workspace and the configured tools. Do not inspect /state or credentials, invoke subagents or network tools, or read runtime implementation. Do not change files outside /workspace. When the tool research_memory_memory_lookup is available, call that exact tool once for relevant prior context before broad navigation. Memory is origin-bound; verify current source when needed and query again after edits before relying on its current availability. Keep the final answer concise."
    }
  },
  "experimental": {
    "schedules": false,
    "artifacts": false,
    "image_generate": false
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "settings": {
            "serviceTier": "priority"
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "research_memory": {
        "type": "local",
        "command": [
          "python",
          "/opt/memory-adapter/memory_adapter.py",
          "serve",
          "--binding",
          "/memory/prepared/binding.json",
          "--trace",
          "/state/evidence/memory-backend-trace.jsonl",
          "--response-format",
          "compact"
        ],
        "cwd": "/workspace",
        "codemode": false,
        "environment": {
          "PYTHONPATH": "/opt/memory-adapter:/opt/cami-src:/opt/cami-deps",
          "PYTHONSAFEPATH": "1"
        },
        "timeout": {
          "startup": 10000,
          "catalog": 10000,
          "execution": 30000
        }
      }
    }
  }
}
